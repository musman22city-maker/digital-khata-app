rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile / Settings
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() <= 100
        && request.resource.data.language in ['en', 'ur'];
      allow delete: if isOwner(userId);

      // Customer subcollection
      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(customerId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 150
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(transactionId)
          && request.resource.data.userId == userId
          && request.resource.data.customerId is string
          && request.resource.data.type in ['gave', 'got']
          && request.resource.data.itemName is string
          && request.resource.data.itemName.size() > 0
          && request.resource.data.itemName.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow delete: if isOwner(userId);
      }
    }
  }
}
