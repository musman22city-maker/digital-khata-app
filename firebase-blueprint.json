{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User ledger store profile and preferences",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "shopPhone": { "type": "string", "maxLength": 50 },
        "shopAddress": { "type": "string", "maxLength": 200 },
        "currency": { "type": "string", "maxLength": 20 },
        "soundEnabled": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "ur"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["shopName", "language"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer party ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" },
        "reminder": { "type": "object" }
      },
      "required": ["id", "userId", "name", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Ledger credit/debit transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["gave", "got"] },
        "itemName": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "receiptNo": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "customerId", "type", "itemName", "amount", "date", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Store settings and preferences per user"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer parties belonging to a user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transactions belonging to a user"
    }
  }
}
